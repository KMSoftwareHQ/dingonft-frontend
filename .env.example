# Local test environment. Production is https://nft.dingocoin.com.
BASE_PATH=/testing-nft-platform
PUBLIC_URL=http://localhost:3020/testing-nft-platform
FRONTEND_PORT=3020
# frontend-v2 dev server (fake data): http://localhost:3022/testing-nft-platform/v2/
V2_PORT=3022
PROVIDER_PORT=8090
POSTGRES_PORT=5434
MINIO_PORT=9210
MINIO_CONSOLE_PORT=9211
# Bucket names are <prefix>-{meta,preview,content,state,profile,collection},
# matching production. Used by the frontend, link, provider, and MinIO init.
STORAGE_BUCKET_PREFIX=dingo-nftc-0

# Set these if the host user is not uid/gid 1001.
DEV_UID=1001
DEV_GID=1001
