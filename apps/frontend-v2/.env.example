# Copy to .env for `npm run dev` outside Docker (the root compose.yaml sets these itself).
BASE_PATH=/v2/
# Browser-side URLs: same-origin paths the dev server proxies (vite.config.js).
VITE_API_URL=/v2/api
VITE_STORAGE_BASE=/v2/storage
VITE_STORAGE_BUCKET_PREFIX=dingo-nftc-0-
# Proxy targets: the fake-data mock (`npm run mock`, port 4000). For production
# data use https://nft.dingocoin.com/api and https://nyc3.digitaloceanspaces.com;
# wallet actions then sign and send real mainnet transactions.
DEV_API_PROXY_TARGET=http://localhost:4000/api
DEV_STORAGE_PROXY_TARGET=http://localhost:4000/storage
# Extra host names the dev server answers to (comma-separated).
DEV_ALLOWED_HOSTS=
