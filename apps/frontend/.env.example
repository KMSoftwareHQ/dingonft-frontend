# Copy to .env to override docker-compose.yml defaults.
FRONTEND_PORT=3020
# Sub-path the app is served under (must match the ccnodes.net Caddy route).
BASE_PATH=/testing-nft-platform
# Where the dev server proxies <BASE_PATH>/storage and <BASE_PATH>/api
# (container names on the dingonft-provider_default network).
DEV_STORAGE_PROXY_TARGET=http://dingonft-provider-minio-1:9000
DEV_API_PROXY_TARGET=http://dingonft-provider-app-1:80
# Bucket name prefix: dingo-nft- (provider dev stack) or dingo-nftc-0- (prod / dingonft-link fixtures).
STORAGE_BUCKET_PREFIX=dingo-nft-
