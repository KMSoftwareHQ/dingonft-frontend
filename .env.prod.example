# Production secrets for compose.prod.yaml. Copy to .env.prod, chmod 600.
# Never commit the filled-in file (.env.prod is gitignored).

# --- Provider platform secrets (from the current production backend) ---
# Must be the ORIGINAL production values: they derive every NFT address and
# co-sign list/buy/reprice transactions. The provider refuses to start without them.
ADDRESSING_SECRET=
PLATFORM_PRIVATE_KEY=

# --- DigitalOcean Spaces (write access to the dingo-nftc-0-* buckets) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_REGION=us-east-1
# STORAGE_BUCKET_PREFIX=dingo-nftc-0

# --- Postgres (local to this host; any strong random value) ---
POSTGRES_PASSWORD=

# PUBLIC_URL=https://nft.dingocoin.com
