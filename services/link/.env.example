# Copy to .env for local development. All values are optional; defaults are in config.js.
NODE_ENV=development
PORT=3000
# Proxy to an independently running frontend (preferred monorepo topology).
# FRONTEND_URL=http://frontend:3000
# Second frontend (apps/frontend-v2) at <BASE_PATH>/v2/, and who may open it.
# FRONTEND_V2_URL=http://frontend-v2:8080
# V2_ALLOWED_IPS=
# Proxy <BASE_PATH>/api/* to the provider (same-origin API in production).
# API_PROXY_URL=http://provider:80
# BASE_PATH=/testing-nft-platform
# ROOT_PATH=https://nft.dingocoin.com
# LOGO=https://nft.dingocoin.com/dingocoin.png
# Alternatively, serve a built frontend directory directly.
# BUILD_DIR=../../apps/frontend/dist
# Object storage. Dev default is local MinIO.
# Uncomment to read real production metadata instead:
# STORAGE_BASE=https://nyc3.digitaloceanspaces.com
# API_URL=https://nftp0.dingocoin.io
# FETCH_TIMEOUT_MS=30000
