# Copy to .env for local development. All values are optional; defaults are in config.js.
NODE_ENV=development
PORT=3000
# Path to a built frontend, relative to this repo. Defaults to ./dev/frontend in development.
# BUILD_DIR=../dingonft-frontend-private
# ROOT_PATH=http://localhost:3000
# Object storage. Dev default is the local MinIO started by `yarn dev:storage`.
# Uncomment to read real production metadata instead:
# STORAGE_BASE=https://ewr1.vultrobjects.com
# API_URL=https://nftp0.dingocoin.io
# FETCH_TIMEOUT_MS=30000
